# Copia este archivo como .env (raíz) y web/.env.local; nunca subas los valores reales.

# ETL → carga a PostgreSQL (Supabase: Project Settings → Database → Connection string, modo sesión)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Front (web/.env.local). Sin estas variables el dashboard usa el snapshot estático.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key
